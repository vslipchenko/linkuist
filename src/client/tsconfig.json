{
  "compilerOptions": {
    "strict": true,
    "baseUrl": "src",
    "rootDir": "src",
    "outDir": "dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "downlevelIteration": true,
    "experimentalDecorators": true,
    "removeComments": true,
    "importHelpers": true,
    "moduleResolution": "node",
    "target": "es2019",
    "module": "es2020",
    "lib": [
      "es2020",
      "dom",
      "esnext.asynciterable"
    ],
    "allowSyntheticDefaultImports": true,
    "paths": {
      "~*": [
        "*"
      ]
      //      "~environments": ["environments/*"]
      //      "@environments/*": [
      //        "environments/*"
      //      ],
      //      "@constants/*": [
      //        "app/constants/*"
      //      ],
      //      "@graphql/*": [
      //        "app/graphql/*"
      //      ],
      //      "@guards/*": [
      //        "app/guards/*"
      //      ],
      //      "@interceptors/*": [
      //        "app/interceptors/*"
      //      ],
      //      "@types/*": [
      //        "app/types/*"
      //      ],
      //      // extra @ prevents reserved @types namespace conflict
      //      "@modules/*": [
      //        "app/modules/*"
      //      ],
      //      "@services/*": ["app/services/*"],
      //      "@shared/*": ["app/shared/*"],
      //      "@utilities/*": ["app/utilities/*"]
    }
  }
}