{
  "compilerOptions": {
    "allowJs": true,
    "module": "commonjs",
    "target": "es2015",
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true
  },
  "exclude": [
    "node_modules",
    "src/**/*.spec.ts"
  ]
}
